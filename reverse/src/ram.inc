sram_69B3               = $69B3
sram_69BA               = $69BA
sramScrollMinPage       = $69C1     ; lowest scroll page, indexed by areaLastPage
sram_69C2               = $69C2
sramScrollMaxPage       = $69C4     ; highest scroll page, indexed by areaLastPage
sram_69C5               = $69C5
sram_69C8               = $69C8
sram_69CC               = $69CC
sram_69CE               = $69CE
sram_69D4               = $69D4
sram_69DA               = $69DA
sram_69DE               = $69DE
; ---------------------------------------------------------------------------
; World data, copied from the area bank when a world is loaded (Mode_LoadWorld).
; The overworld location tables are z2edit's "connector" tables.
; ---------------------------------------------------------------------------
sramLocY                = $6A00     ; [63] overworld locations: bit 7 = external, bits 6-0 = Y
sramLocX                = $6A3F     ; [63] bit 7 = second exit lower, bit 6 = second, bits 5-0 = X
sramLocArea             = $6A7E     ; [63] bits 7-6 = start page, bits 5-0 = area
sramLocDest             = $6ABD     ; [63] bit 7 = fall, bit 6 = pass through, bit 5 = enter from the right, bits 4-2 = world, bits 1-0 = overworld
sramRoomConnections     = $6AFC     ; [252] side view area connections, 4 per area
sramDoors               = $6BF8     ; [96] side view doors (provisional)
; Enemy definitions: tables with one entry per enemy type (36 in the
; overworld banks).
sramProjectilePtrs      = $6D00     ; [11] (16-bit) routine for each projectile type (objState+7 - 1); first of the enemy definition tables, from the area bank at $9400 ($A900 in world 4)
sramProjectileFlags     = $6D17     ; [10] per projectile type: bits 7-6 = $80 reflectable, bit 5 = survives hitting Link, bit 3 = large hitbox (provisional)
sramEnemyHp             = $6D21     ; [36] hit points of each enemy type
sramEnemyInitPtrs       = $6D45     ; [36] (16-bit) routine run when each enemy type spawns (Enemy_Spawn)
sramEnemyAiPtrs         = $6D8D     ; [36] (16-bit) routine that runs each enemy type every frame
sramEnemyAttr           = $6DD5     ; [36] bits 7-6 = sprite palette, bit 4 = drains experience; experience (provisional)
sramEnemyDamage         = $6DF9     ; [36] bits 7-6 = item drop group, bits 3-0 = damage class of each enemy type
sramEnemyHitbox         = $6E1D     ; [36] hitbox of each enemy type: offset into EnemyHitboxes / 4
sramEnemyFlags          = $6E41     ; [36] bit 6 = comes back after dying, bit 4 = not hurt by the sword, bits 3-0 = background collision probe set
sramEnemyDrawPtrs       = $6E65     ; [36] (16-bit) routine that draws each enemy type
sramProjectileTiles     = $6EAD     ; [9] sprite tile of each projectile type (entry 0 is the area bank's rts at $95AD)
sramProjectileAttrs     = $6EB6     ; [8] sprite attributes of each projectile type
sram_6EBE               = $6EBE
sramProjectileDrawPtrs  = $6EC0     ; [10] (16-bit) draw routine of each projectile type, jumped to by Projectile_Draw_*
sramEnemyTiles          = $6ED4     ; sprite tile numbers for drawing enemies
sramEnemyLists          = $7000     ; [1024] enemies of each area, from AreaBank::EnemyLists
; Save files (battery-backed).  The status bytes are SAVE_STATUS_*.
; ---------------------------------------------------------------------------
sramSaveStatus0         = $7400     ; save file 0 status
sramSaveStats           = $7402     ; [3][SAVE_STATS_SIZE] save file stats
sramSaveStatus1         = $7498     ; save file 1 status
sramSaveWorld           = $749A     ; [3][SAVE_WORLD_SIZE] save file world state
sramSaveStatus2         = $773A     ; save file 2 status
sramMenuText            = $7800     ; [280] text of the pause menu and level up window, copied from MenuTextTemplate and filled in
sramAreaPalettes        = $7919     ; [224] area palettes, from AreaBank::Palettes
sramOverworldMap        = $7C00     ; [896] compressed overworld map of the region

; ---------------------------------------------------------------------------
; Overlays: the title and file screens (bank 5) run before any game object
; exists, and keep their variables in the object slot arrays.
; ---------------------------------------------------------------------------
; Title screen and story scroll (Title_*, Story_*)
titleBgAddr             = objY+0    ; (16-bit, high byte first) nametable address of the next background row (Title_DrawBgRow)
titleTextAddr           = objY+2    ; (16-bit, high byte first) nametable address of the next story text row
titleAttrAddr           = objY+4    ; (16-bit, high byte first) attribute address of the next story text attributes
titleBgAttrAddr         = objY+6    ; (16-bit, high byte first) attribute address of the next background attributes (Title_DrawBgAttr)
titleBgRow              = objY+8    ; next background row to draw (0-29, TitleBgRowPtrsLo)
titleAttrRow            = objY+9    ; next story attribute row (0-7, StoryAttrPtrsLo)
titleTextLine           = objY+10   ; next story text line (0-14, StoryTextPtrsLo)
titleLogoString         = objY+11   ; next logo string to redraw at the end of the story (0-7, TitleLogoPtrs)
titleEndStep            = objY+12   ; step of Story_End
titleSplitNametable     = objY+13   ; nametable bits (PPUCTRL) below the sprite 0 split
titleShootingStar       = objYHi+13 ; nonzero while the shooting star falls
titleSplitAddr          = objYHi+14 ; (16-bit, high byte first; the low byte is ram_0028) PPU address written below the sprite 0 split, which sets the scroll there
titleScrollHeld         = objXHi+4  ; nonzero while the story scroll waits for the music
titleDelay              = timerFast+3 ; delay before the story scrolls, counted down every 4 frames (Story_TickDelay)
; File screens (FileSelect_*, Register_*, Eliminate_*)
fileCursor              = objYHi+0  ; cursor: file 0-2, 3 = REGISTER YOUR NAME or END, 4 = ELIMINATION MODE
fileEmptyMask           = objYHi+1  ; bit n set if file n is empty (FileSelect_FindEmpty); bit 3 set on the name screens
fileCursorY             = objYHi+2  ; Y of the fairy cursor
fileCursorTile          = objYHi+3  ; tile of the fairy cursor (it flaps every 4 frames)
fileBlinkTimer          = objYHi+4  ; counts frames, for flapping and blinking
nameCursor              = objYHi+5  ; position in the name being entered (0-7)
letterColumn            = objYHi+6  ; letter grid column (0-10)
letterRow               = objYHi+7  ; letter grid row (0-3)
letterHeld              = objYHi+8  ; nonzero while the direction pad is held
letterRepeatTimer       = objYHi+9  ; frames the direction pad has been held (auto-repeat)
letterCursorX           = objYHi+10 ; X of the letter grid cursor
nameCursorY             = objYHi+11 ; Y of the name cursor ($F8 = hidden, blinking)
letterCursorY           = objYHi+12 ; Y of the letter grid cursor ($F8 = hidden, blinking)
fileCursorX             = objX+0    ; X of the fairy cursor
nameCursorX             = objXSubpixel+0 ; X of the name cursor
sramFileScreenText      = sramOverworldMap+$300 ; [166] PPU strings of the file select screen, copied from FileScreenText and filled in
; Ending (Ending_*, Curtain_*, Credits_*; the objects are gone by then)
endingTimer             = objY+14   ; frames left in the current scene (Ending_Wait; 96 when it starts)
endingSubStep           = objY+10   ; step within a scene (curtain, credits)
triforceY               = objY+15   ; [3] Y of the three Triforce pieces
triforceX               = objXHi+0  ; [3] X of the three Triforce pieces
messageIndex            = objXHi+3  ; next letter of EndingMessage (Ending_TypeMessage)
curtainPhase            = objXHi+4  ; 0-3: which pair of curtain rows is drawn next (Curtain_QueueRows)
curtainAddr             = objYHi+14 ; (16-bit, high byte first: $0027-$0028) nametable address of the curtain's bottom edge
curtainAttrLo           = objY+5    ; low byte of the attribute address ($23xx) set below the curtain, +8 every 4 edge draws (Curtain_DrawEdge)
curtainEdgeCount        = objY+9    ; edge draws so far; bits 1-3 pick the attribute value (CurtainEdgeAttr)
creditsString           = objX+7    ; next string of CreditsText (0-17; 18 = done)
creditsFadeStep         = objX+8    ; 0-3 fade in, 4 hold, 5-7 fade out (CreditsFadeDelays)

; Title sound engine (Sound_TitleEngine, bank 6): the same RAM as the gameplay
; engine, used differently.
titleSongRequest        = soundMute ; title song (part bit) to start: $01 starts the song from its intro; $80 (Title_CheckStart) is no part and stops it
titleSfxRequest         = musicRequest ; title sound effects to start: bit 0 ... bit 3 (the file screens' cursor and letter sounds)
titleSfx                = dmcRequest ; title sound effect playing; the pulse channels' music is silent meanwhile
titleSfxTimer           = sq1TimerLo ; frames left of the title sound effect
titleNotesPtr           = musicNotesPtr ; (16-bit) note data of the title song's phrase
titleSq2Offset          = musicSong ; offset of the next pulse 2 (melody) note
titleSq1Offset          = musicPhrase ; offset of the next pulse 1 note (0 = none in this phrase)
titleTriOffset          = drumLoopOffset ; offset of the next triangle note (0 = none)
titleNoiseOffset        = musicTempo ; offset of the next noise note (0 = none)
titleNoiseLoop          = $07F6     ; titleNoiseOffset to return to when the noise part ends
titleDurationBase       = noiseSfxTimer ; offset of the phrase's row of note lengths in TitleNoteLengths
titleSq2EnvBase         = $07F1     ; offset of pulse 2's volume envelope in TitleEnvelopes
titleSq1EnvBase         = $07F0     ; offset of pulse 1's volume envelope in TitleEnvelopes
titlePhrase             = sq2SfxTimer ; next entry of the title song part's phrase list
titleSongPart           = $07F8     ; title song part number (titleMusicPart bit number + 1)
titleSq2Timer           = sfxRequest ; frames left of the pulse 2 note
titleSq1Timer           = sfxRequest+1 ; frames left of the pulse 1 note
titleTriTimer           = sfxRequest+2 ; frames left of the triangle note
titleNoiseTimer         = sfxRequest+3 ; frames left of the noise note
titleSq2Length          = sq1Sfx    ; length of pulse 2's notes
titleSq1Length          = sq2Sfx    ; length of pulse 1's notes
titleTriLength          = noiseSfx  ; length of the triangle's notes
titleNoiseLength        = $07FC     ; length of the noise notes
titleSq2Pitch           = laughSampleTimer ; pitch of the pulse 2 note, echoed on pulse 1 in the intro
titleSq2EnvStep         = musicPlaying ; pulse 2 envelope step, counting down
titleSq1EnvStep         = sq1SfxTimer ; pulse 1 envelope step, counting down
titleEcho               = dmcTimer  ; nonzero in the intro (part 1), where pulse 1 echoes the melody
titleEchoDelay          = dmcEnableTimer ; frames since the melody note, up to the echo at 8
titleEchoEnvStep        = dmcSfx    ; pulse 1 envelope step of the echo
titleSq2Swell           = harmonyOffset ; envelope start of pulse 2's notes in the intro, rising by 2 a note from $20 to $5F
titleEchoSwell          = bassOffset ; envelope start of the echo, rising like titleSq2Swell
titleSq1TimerLo         = $07F4     ; timer low byte of pulse 1's note, the base for its vibrato
titleSq2TimerLo         = $07F3     ; timer low byte of pulse 2's note, the base for its vibrato
titleVibratoBase        = $07F2     ; vibrato base being used (Title_Vibrato)

.endif
