                    hp: {Prg: [1, 0x9421]},
                    xp: {Prg: [1, 0x94d5]},
                    table_len: 36,
                    group: {
                        // Notes on tile ids in the `sprites` field:
                        // Zelda2 programs the NES PPU to use double-tall sprites (8x16).  As
                        // such, the LSB of each tile ID tells the PPU which of the two currently
                        // mapped CHR banks to read the tile from.
                        //
                        // In this file, I have added additional metadata to the tile IDs to be
                        // able to draw sprites which are composed of sprites on non-8x16 aligned
                        // offsets, or are large mirrored sprites.  For example, the large
                        // skull bubble in the great palace looks like a 32x32 sprite, however,
                        // it is layed out like this:
                        //
                        //    AB
                        //   sABs
                        //   sCDs
                        //    CD
                        //
                        // In order to accomodate the y-offseted and mirrored (S)ides of the bubble,
                        // the upper bits of the sprite ID can encode additional information:
                        //
                        //
                        // bit: 2        1        0        0
                        //      4        6        8        0
                        // id:  m xxxxxxxx yyyyyyyy iiiiiiib
                        //
                        // Bit 24 unconditionally mirrors the sprite about the x axis.
                        //        xxxxxxxx = xoffset to render the sprite.
                        //        yyyyyyyy = xoffset to render the sprite.
                        //        iiiiiiib = the sprite ID and bank offset.
                        "0": { offset: 0, name: "Fairy", chr: {Chr: [2, 0]}, palette: 1, size: [8, 16], sprites: [0x6a] },
                        "1": { offset: 1, name: "Red Jar", chr: {Chr: [2, 0]}, palette: 2, size: [8, 16], sprites: [0x8a] },
                        "2": { offset: 2, name: "Door", chr: {Chr: [2, 0]}, palette: 1, size: [8, 48], sprites: [0x74, 0x76, 0x74] },
                        "3": { offset: 3, name: "Myu", chr: {Chr: [2, 0]}, palette: 3, size: [16, 16], sprites: [0x24, 0x24] },
                        "4": { offset: 4, name: "Bot", chr: {Chr: [2, 0]}, palette: 3, size: [16, 16], sprites: [0xb4, 0xb4] },
                        "5": { offset: 5, name: "Bit", chr: {Chr: [2, 0]}, palette: 2, size: [16, 16], sprites: [0xb4, 0xb4] },
                        "6": { offset: 6, name: "Moa", chr: {Chr: [2, 0]}, palette: 3, size: [16, 16], sprites: [0xb6, 0xb8] },
                        "7": { offset: 7, name: "Ache", chr: {Chr: [2, 0]}, palette: 3, size: [16, 16], sprites: [0x4e, 0x4e] },
                        "10": { offset: 10, name: "Acheman", chr: {Chr: [2, 0]}, palette: 2, size: [16, 32], sprites: [0x7c, 0x7e, 0x80, 0x82 ]},
                        "11": { offset: 11, name: "Bubble Generator", chr: {Chr: [2, 0]}, palette: 3, size: [8, 16], sprites: [0xaa]},
                        "12": { offset: 12, name: "Rock Generator", chr: {Chr: [2, 0]}, palette: 2, size: [8, 16], sprites: [0xae]},
                        "13": { offset: 13, name: "Red Deeler", chr: {Chr: [2, 0]}, palette: 2, size: [16, 16], sprites: [0xba, 0xbc]},
                        "14": { offset: 14, name: "Blue Deeler", chr: {Chr: [2, 0]}, palette: 3, size: [16, 16], sprites: [0xba, 0xbc]},
                        "15": { offset: 14, name: "Bago Bago Generator", chr: {Chr: [2, 0]}, palette: 0, size: [16, 16], sprites: [0xc0, 0xc4]},
                        "16": { offset: 16, name: "Bago Bago", chr: {Chr: [2, 0]}, palette: 0, size: [16, 16], sprites: [0xc0, 0xc4]},
